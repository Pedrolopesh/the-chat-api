# Copie para .env (desenvolvimento). Em produção o pipeline gera o .env
# a partir dos secrets do GitHub (ver README, seção Deploy).
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

MONGO_URL=mongodb://localhost:27017/thechat
# gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:8080
APP_URL=http://localhost:8080
TRUST_PROXY=0

# código de acesso por e-mail (Resend). Sem a chave, em desenvolvimento o
# código aparece no log da API.
RESEND_API_KEY=
MAIL_FROM=The Chat <no-reply@pedrolopes.tech>

# notificações push (opcional) — gere com: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@pedrolopes.tech

# bucket S3/R2 para avatares e backups (opcional)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_PREFIX=the-chat/avatars
